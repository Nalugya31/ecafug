{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "ecafug.vercel.app" }],
      "destination": "https://ecaoug.org/:path*",
      "permanent": true
    }
  ]
}